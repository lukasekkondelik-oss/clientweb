# Základní URL produkčního webu (bez lomítka na konci). Používá se pro SEO
# metadata (canonical, Open Graph), sitemap.xml a robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.romanareality.cz

# URL Cal.com rezervačního odkazu (např. https://cal.com/romana-trefna/konzultace).
# Když je prázdné, sekce rezervace zobrazí profesionální demo stav místo
# nefunkčního iframe.
NEXT_PUBLIC_CALCOM_URL=

# Zapíná demo panel pro prezentaci klientce (simulace success/error stavů
# formulářů). Na produkčním webu nechte prázdné nebo nastavte na false.
NEXT_PUBLIC_DEMO_MODE=true

# Webhook (např. n8n scénář), který přijaté leady dále routuje do Raynetu.
# Používá se jako výchozí fallback, pokud není nastaven specifický webhook
# níže. Nikdy sem nepatří přímo Raynet API klíč.
RAYNET_WEBHOOK_URL=

# Volitelné specifické webhooky pro jednotlivé typy leadů. Pokud nejsou
# nastavené, použije se RAYNET_WEBHOOK_URL. Pokud není nastaveno nic, lead se
# pouze zaloguje na serveru (bezpečný no-op v prototypu).
VALUATION_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
VIEWING_WEBHOOK_URL=
